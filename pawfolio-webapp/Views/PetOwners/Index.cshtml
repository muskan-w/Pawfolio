@model IEnumerable<pawfolio_webapp.Models.Pet>
@{
    ViewData["Title"] = "Pet Owners Page";
}

<div class="pets-page">

    <!-- Welcome heading -->
    <div class="pets-header">
        <h1>Welcome to Pawfolio!</h1>
        <p>Your pet care journey starts here. What would you like to do today?</p>
    </div>

    <!-- Dashboard cards -->
    <div class="pets-grid">

        <!-- View My Pets card -->
        <div class="pet-card">

            <div class="pet-icon">
                <img src="~/images/logo.png" alt="Logo"/>
            </div>

            <div class="pet-info">
                <h2>View My Pets</h2>
                <p>See and manage all your pet profiles in one place.</p>
            </div>

            <div class="pet-actions">
                <a asp-controller="Pets"
                   asp-action="Index"
                   class="pet-edit">
                    View My Pets
                </a>
            </div>

        </div>

        <!-- Create another pet card -->
        @if (Model?.Any() == true)
        {
            <div class="pet-card">

                <div class="pet-icon">
                    <img src="~/images/care.jpg" alt="Add another pet"/>
                </div>

                <div class="pet-info">
                    <h2>Create Another Pet</h2>
                    <p>Have another furry friend? Add them to your Pawfolio!</p>
                </div>

                <div class="pet-actions">
                    <a asp-controller="Pets"
                       asp-action="Create"
                       class="pet-edit">
                        Add Another Pet
                    </a>
                </div>

            </div>
        }
        else
        {
            <!-- First pet profile card -->
            <div class="pet-card">

                <div class="pet-icon">
                    <img src="~/images/care.jpg" alt="Create a pet profile"/>
                </div>

                <div class="pet-info">
                    <h2>Create Your First Pet</h2>
                    <p>Start building your Pawfolio by creating your first pet profile!</p>
                </div>

                <div class="pet-actions">
                    <a asp-controller="Pets"
                       asp-action="Create"
                       class="pet-edit">
                        Create Pet Profile
                    </a>
                </div>

            </div>
        }

    </div>
</div>
