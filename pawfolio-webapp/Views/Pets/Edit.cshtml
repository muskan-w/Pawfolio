@model pawfolio_webapp.Models.Pet

@{
    ViewData["Title"] = "Edit Pet Profile";
}

<div class="pet-form-page">

    <!-- Page heading -->
    <div class="pet-form-header">
        <h1>Edit Pet Profile</h1>
        <p>Update your pet's information below.</p>
    </div>

    <!-- Edit form -->
    <div class="pet-form-card">

        <form asp-action="Edit" method="post">

            <!-- Hidden field to pass the pet ID -->
            <input type="hidden" asp-for="Id"/>

            <!-- Display validation errors -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Pet name -->
            <div class="pet-form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Pet breed -->
            <div class="pet-form-group">
                <label asp-for="Breed"></label>
                <input asp-for="Breed" class="form-control"/>
                <span asp-validation-for="Breed" class="text-danger"></span>
            </div>

            <!-- Pet age -->
            <div class="pet-form-group">
                <label asp-for="Age"></label>
                <input asp-for="Age" class="form-control"/>
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <!-- Pet gender -->
            <div class="pet-form-group">
                <label asp-for="Gender"></label>
                <input asp-for="Gender" class="form-control"/>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <!-- Pet species -->
            <div class="pet-form-group">
                <label asp-for="Species"></label>
                <input asp-for="Species" class="form-control"/>
                <span asp-validation-for="Species" class="text-danger"></span>
            </div>

            <!-- Form buttons -->
            <div class="pet-form-actions">
                <button type="submit" class="pawfolio-btn pet-submit-btn">
                    Save Changes
                </button>

                <a asp-action="Index" class="pet-back-btn">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
