@model IEnumerable<pawfolio_webapp.Models.Pet>

@{
    ViewData["Title"] = "My Pets";
}

<div class="pets-page">

    <!-- Page heading -->
    <div class="pets-header">
        <div class="pets-heading">
            <h1>My Pets</h1>
            <p>All your pet profiles exist here - in one space.</p>
        </div>

        <a asp-action="Create" class="pawfolio-btn pets-add-btn">
            + Add A Pet
        </a>
    </div>

    <!-- Display all pet profiles -->
    @if (Model != null && Model.Any())
    {
        <div class="pets-grid">

            @foreach (var item in Model)
            {
                <div class="pet-card">

                    <div class="pet-icon">
                        <img src="~/images/care.jpg" alt="Logo"/>
                    </div>

                    <div class="pet-info">
                        <h2>@item.Name</h2>

                        <p class="pet-breed">@item.Breed</p>

                        <div class="pet-details">
                            <span>Age: @item.Age</span>
                            <span>Gender: @item.Gender</span>
                            <span>Species: @item.Species</span>
                        </div>
                    </div>

                    <div class="pet-actions">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="pet-edit">
                            Edit Profile
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="pet-delete">
                            Delete
                        </a>
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="pets-empty">
            <h2>You don't have any pet profiles yet!</h2>
            <p>Start by creating a profile for your pet.</p>

            <a asp-action="Create" class="pawfolio-btn">
                Create Your Pet Profile
            </a>
        </div>
    }

</div>
