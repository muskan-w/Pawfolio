@page
@model pawfolio_webapp.Areas.Identity.Pages.Account.RegisterModel
    
@{
    ViewData["Title"] = "Register";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="p3 rl-main-div">
    <div class="rl-card">
        <div class="feature d-block">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                
                <h3 class="rl-title">Create a new account</h3>

                <div asp-validation-summary="ModelOnly" class="text-danger rl-validation-summary"></div>
            
                <div class="form-group mb-3">
                    <label asp-for="Input.FirstName">First Name</label>
                    <input asp-for="Input.FirstName" class="form-control" />
                    <span asp-validation-for="Input.FirstName" class="text-danger rl-validation-summary"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Input.LastName">Last Name</label>
                    <input asp-for="Input.LastName" class="form-control" />
                    <span asp-validation-for="Input.LastName" class="text-danger rl-validation-summary"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Input.Role">Account Type</label>
                    <select asp-for="Input.Role" class="form-control select-list">
                        <option value="" disabled selected>-- Select your role --</option>
                        <option value="PetOwner">Pet Owner</option>
                        <option value="VeterinaryProfessional">Veterinary Professional</option>
                    </select>
                    <span asp-validation-for="Input.Role" class="text-danger rl-validation-summary"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger rl-validation-summary"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password" class="form-control" />
                    <span asp-validation-for="Input.Password" class="text-danger rl-validation-summary"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Input.ConfirmPassword"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger rl-validation-summary"></span>
                </div>
                <div class="form-actions">
                    <button id="registerSubmit" type="submit" class="pawfolio-btn rl-btn">Register</button>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="rl-link">Already have an account? Sign in</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}