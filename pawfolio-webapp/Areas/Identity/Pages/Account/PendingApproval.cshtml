@page
@model pawfolio_webapp.Areas.Identity.Pages.Account.PendingApprovalModel
@{
    ViewData["Title"] = "Approval pending";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="p3 rl-main-div">
    <div class="rl-card">
        <div class="feature d-block text-center">
            <h3 class="rl-title">Approval pending</h3>
            <hr />
            <p>Your veterinary professional registration has been submitted.</p>
            <p>An administrator must review and approve your professional details before you can access the veterinary professional page.</p>
            <p>It should take less than 48 hours for your registration to be reviewed.</p>
            <p>Please check back after your registration has been reviewed.</p>
        </div>
    </div>
</section>
